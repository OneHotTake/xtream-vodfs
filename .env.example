# Xtream Credentials
XTREAM_BASE_URL=http://example.com:8080
XTREAM_USERNAME=your_username
XTREAM_PASSWORD=your_password

# Library Settings
ENABLE_VOD=true
ENABLE_SERIES=false
MOVIES_INCLUDE_ALL=true
MOVIES_INCLUDE_CATEGORIES=true
INCLUDE_CATEGORIES=
EXCLUDE_CATEGORIES=

# Server Settings
HOST=127.0.0.1
PORT=8080

# Streaming Settings
UPSTREAM_TIMEOUT=30

# Cache Settings (Sprint 3)
CACHE_DIR=./config
VOD_CATEGORIES_TTL=43200
VOD_STREAMS_TTL=86400

# Rate Limiting (Sprint 3)
MAX_CONCURRENT_REQUESTS=5
RATE_LIMIT_REQUESTS_PER_MINUTE=60